# ═══════════════════════════════════════════════════════════
# SADYA Backend — Variables de Entorno (Plantilla)
# ═══════════════════════════════════════════════════════════
# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env real a GitHub.

# Conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/nombre_base_datos

# Puerto del servidor Express
PORT=3001

# Entorno de ejecución (development | production)
NODE_ENV=development

# Configuración de Twilio SMS (Opcional - Si no se define, se simula en consola y response)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Configuración de Servidor de Correo SMTP para recuperación de contraseña
# E.g. Gmail (usa "Contraseñas de aplicación" de Google en tu cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-aplicación-de-16-caracteres


# Dominios del frontend que pueden llamar al API en producción (separados por coma)
CORS_ORIGINS=https://sadya.co,https://www.sadya.co

# Clave para firmar las sesiones (JWT). Usa un texto largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
